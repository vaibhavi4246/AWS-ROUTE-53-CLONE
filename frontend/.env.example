# Option A (default): the browser calls the backend directly.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Option B: same-origin proxy through Next.js rewrites. Set this at BUILD time and leave
# NEXT_PUBLIC_API_URL unset. The session cookie then belongs to the frontend's own domain, which
# avoids third-party-cookie blocking when frontend and backend are hosted on different sites.
# API_PROXY_TARGET=https://your-backend.onrender.com
