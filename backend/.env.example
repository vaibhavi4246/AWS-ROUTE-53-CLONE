# Copy to .env (or set these in your host's dashboard). Every value has a safe local default.

# SQLite file. On a host with a persistent disk use an absolute path, e.g. sqlite:////data/route53.db
DATABASE_URL=sqlite:///./route53.db

# Secret used to sign session tokens. CHANGE THIS in any deployed environment.
SECRET_KEY=change-me-to-a-long-random-string

# Origin of the deployed frontend (used for CORS and to decide on SameSite=None; Secure cookies).
FRONTEND_URL=http://localhost:3000

# Session lifetime in seconds (default: 1 day).
TOKEN_TTL_SECONDS=86400

# Passwordless one-click demo login with sample data. Set to false to disable it.
DEMO_MODE=true
DEMO_USERNAME=demo

# Seeded mock account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
AWS_ACCOUNT_ID=1234-5678-9012
